<robot xmlns:xacro="http://wiki.ros.org/xacro" name="apriltag">

    <!-- Set use_sim argument to let panther xacro load gazebo plugin: -->
    <xacro:arg name="index" default="" />
    <xacro:arg name="parent" default="world" />

    <!-- Create apriltag link: -->
    <link name='base_link'>
        <visual name='visual'>
            <origin xyz="0 0 0" rpy="0 1.57 3.14" />
            <geometry>
                <mesh filename="/tmp/apriltag_$(arg index).glb" />
            </geometry>
        </visual>
        <inertial>
            <mass value="0.1" />
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
        </inertial>
    </link>

    <!-- Gazebo requires a joint to a link called "world" for statically mounted platforms -->
    <xacro:property name="parent" value="$(arg parent)" />
    <xacro:if value="${parent == 'world'}">
        <link name="${parent}" />
        <joint name="${parent}_joint" type="fixed">
            <parent link="${parent}" />
            <child link="base_link" />
        </joint>
    </xacro:if>
</robot>