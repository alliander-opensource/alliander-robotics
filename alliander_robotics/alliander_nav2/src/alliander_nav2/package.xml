<package format="3">
  <name>alliander_nav2</name>
  <version>0.1.0</version>
  <description>Contains the Alliander Robotics configuration for ROS2's nav2 stack.</description>
  <maintainer email="robots@alliander.com">Alliander Robotics</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>pkg-config</build_depend>
  <build_depend>libgeographiclib-dev</build_depend>

  <depend>rclcpp</depend>
  <depend>nav2_behavior_tree</depend>
  <depend>geographic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>robot_localization</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>navigation2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>