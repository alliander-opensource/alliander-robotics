<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur">

  <xacro:arg name="simulation" default="" />
  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="ros_namespace" default="" />
  <xacro:arg name="childs" default="${[]}" />

  <xacro:arg name="name" default="ur" />
  <xacro:arg name="ur_type" default="ur7e" />

  <xacro:if value="$(arg simulation)">
    <xacro:include filename="$(find alliander_ur_description)/urdf/adapted/ur_gz.urdf.xacro" />
  </xacro:if>
  <xacro:unless value="$(arg simulation)">
    <xacro:include filename="$(find ur_robot_driver)/urdf/ur.urdf.xacro" />
  </xacro:unless>

  <!-- Create detachable joints with given childs: -->
  <xacro:include filename="$(find alliander_description)/urdf/detachable_joints.urdf.xacro" />
  <xacro:detachable_joints childs="${$(arg childs)}" />

  <!-- Create tcp link: -->
  <link name="tcp" />
  <joint name="tcp_joint" type="fixed">
    <origin xyz="0 0 0" rpy="3.1416 0 0" />
    <parent link="tool0" />
    <child link="tcp" />
  </joint>

</robot>
