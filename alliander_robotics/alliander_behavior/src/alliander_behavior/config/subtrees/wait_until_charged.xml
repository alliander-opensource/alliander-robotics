<?xml version="1.0" encoding="UTF-8"?>
<BehaviorTree ID="WaitUntilCharged">
  <Timeout msec="{timeout_ms}">
    <!-- Wait until charged: invert "IsBatteryLow" logic. Keep retrying until we get a SUCCESS (e.g. battery >= 90%) -->
    <RetryUntilSuccessful num_attempts="-1">
      <Inverter>
	<IsBatteryBelow threshold="{target}"/>
      </Inverter>
    </RetryUntilSuccessful>
  </Timeout>
</BehaviorTree>

