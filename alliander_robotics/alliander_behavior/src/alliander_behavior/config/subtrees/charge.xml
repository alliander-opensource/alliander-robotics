<root>
  <BehaviorTree ID="Charge">
    <Sequence>
      <IsBatteryBelow threshold="{battery_threshold_low}"/>
      <DockRobot name="DockRobot"/>
      <SubTree ID="WaitUntilCharged" _autoremap="true"/>
      <UndockRobot name="UndockRobot"/>
    </Sequence>
  </BehaviorTree>
</root>
