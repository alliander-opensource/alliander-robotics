<root BTCPP_format="4">
  <BehaviorTree ID="PatrolAndCharge">
    <Repeat num_cycles="-1">
      <ReactiveFallback>
	<!-- ReactiveFallback: keep patrolling until one of the earlier childs returns SUCCESS -->
	<SubTree ID="Charge" _autoremap="true"/>

	<Sequence name="ApplyNewRoute">
	  <ScriptCondition code="has_new_route == true"/>
	  <LoadRoute pending="{pending_route}" route="{route}"
	    waypoint_index="{waypoint_index}" has_new_route="{has_new_route}"/>
	</Sequence>
	<!---->
	<SubTree ID="Patrol" _autoremap="true"/>
      </ReactiveFallback>
    </Repeat>
  </BehaviorTree>
</root>
