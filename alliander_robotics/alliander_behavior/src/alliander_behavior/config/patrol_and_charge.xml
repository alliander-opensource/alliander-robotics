<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="PatrolAndCharge">
    <Repeat num_cycles="-1">
      <ReactiveFallback>
        <Sequence name="Charge">
	  <IsBatteryBelow threshold="{battery_threshold_low}"/>
	  <CallTriggerAction name="DockRobot" action_name="{dock_robot_action}"/>
	  <SubTree ID="WaitUntilCharged" target="{battery_threshold_charged}" timeout_ms="{charge_timeout_ms}"/>
	  <CallTriggerAction name="UndockRobot" action_name="{undock_robot_action}"/>
        </Sequence>
        <Sequence name="Patrol">
          <GetCurrentWaypoint/>
	  <NavigateToPose action_name="{navigate_to_pose_action}"/>
          <IncrementWaypoint/>
        </Sequence>
      </ReactiveFallback>
    </Repeat>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="DockRobot"
            editable="true"/>
    <Action ID="GetCurrentWaypoint"
            editable="true"/>
    <Action ID="IncrementWaypoint"
            editable="true"/>
    <Condition ID="IsBatteryLow"
               editable="true"/>
    <Action ID="NavigateToPose"
            editable="true"/>
    <Action ID="UndockRobot"
            editable="true"/>
    <Action ID="WaitUntilCharged"
            editable="true"/>
  </TreeNodesModel>

</root>
