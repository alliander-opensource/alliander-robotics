<root BTCPP_format="4">
  <BehaviorTree ID="GetCurrentWaypoint">
    <Sequence>
      <SelectWaypoint route="{route}" waypoint_index="{waypoint_index}" latitude="{lat}" longitude="{lon}" orientation="{orientation}"/>
      <FromLL latitude="{lat}" longitude="{lon}" map_point="{map_point}"/>
      <MakePose point="{map_point}" orientation="{orientation}" frame_id="map" pose="{current_waypoint}"/>
    </Sequence>
  </BehaviorTree>
</root>
