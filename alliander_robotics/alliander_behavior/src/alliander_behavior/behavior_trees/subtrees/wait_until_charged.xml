<root BTCPP_format="4">
  <BehaviorTree ID="WaitUntilCharged">
    <Timeout msec="{@charge_timeout_ms}">
      <!-- Invert "IsBatteryBelow" logic. Keep running until SUCCESS (battery > threshold) -->
      <Inverter>
        <KeepRunningUntilFailure>
          <IsBatteryBelow name="WaitUntilCharged" threshold="{@battery_threshold_charged}" percentage_scale="{@battery_percentage_scale}"/>
        </KeepRunningUntilFailure>
      </Inverter>
    </Timeout>
  </BehaviorTree>
</root>
